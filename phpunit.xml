<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Variance élite (3.6) désactivée par défaut en test : scénarios
             déterministes ; un test dédié la réactive via config(). -->
        <env name="JEU_ELITE_ACTIF" value="false"/>
        <!-- Fournisseur LLM forcé pour des tests déterministes (les skills
             fakent Anthropic) : indépendant du LLM_PROVIDER du .env de dev. -->
        <env name="LLM_PROVIDER" value="anthropic"/>
        <!-- AUCUNE CLÉ D'API EN TEST (2026-11-20). Les tests lisent le .env du dépôt : sans ces lignes, ils
             recevaient les VRAIES clés, et chaque quête démarrée sans `Http::fake()` appelait Anthropic,
             Gemini et Voyage — ~18 requêtes et ~20 s par démarrage, facturées. `force` : ces valeurs
             priment sur l'environnement. Un test du chemin IA pose sa clé par config() et fake ses réponses ;
             toute requête non fakée échoue (`Http::preventStrayRequests()`, tests/TestCase.php). -->
        <env name="ANTHROPIC_API_KEY" value="" force="true"/>
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <env name="VOYAGE_API_KEY" value="" force="true"/>
        <!-- Journal de test : les WARNING attendus des replis LLM (sans clé API) partaient
             dans storage/logs/laravel.log, le journal que lit la production. `null` est lu
             comme la valeur PHP null par env() ; LogManager retombe alors sur le canal
             `null`, mais seulement en APP_ENV=testing : hors tests, il n'y a pas de repli,
             ne jamais reprendre cette valeur dans le .env. -->
        <env name="LOG_CHANNEL" value="null"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
