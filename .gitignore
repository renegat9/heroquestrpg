# captures Playwright (locales)
browser-shots/*.png

# audio généré/déposé (régénérable / fourni — hors dépôt)
/public/audio/barks
/public/audio/narration
/public/audio/ambiance

# images générées (catalogue + dynamiques — régénérables, hors dépôt)
/public/images

# artefacts Windows (flux ADS de fichiers téléchargés) — bruit, hors dépôt
*:Zone.Identifier

# Worktrees d agents (isolés, jamais versionnés)
.claude/worktrees/

# Sessions navigateur du pilote de test (cookies de connexion)
browser-shots/pilote/etats/
# États de session Playwright (cookies) écrits par jet-des.mjs
browser-shots/*-state.json
browser-shots/jd-*.json

# Harnais de campagne : le CODE est versionné (browser-shots/campagne/*.sh|py|md),
# l'ÉTAT d'une partie jouée ne l'est pas — cookies de session, identifiants de
# héros, code de groupe.
/browser-shots/campagne/jar-*.txt
/browser-shots/campagne/perso-*.txt
/browser-shots/campagne/groupe.txt
# Les PID des boucles de fond (battement de cœur de la table, figurants) : ils
# ne valent que pour la session qui les a lancées, et un PID versionné revient
# à demander à la prochaine campagne de tuer un processus qui ne lui appartient
# pas — voire un autre programme réutilisant le même numéro.
/browser-shots/campagne/*.pid
